geom_abline(intercept = 0, slope = 1, color = "black") +
xlim(range(unlist(RR_df[,1:2]))) +
ylim(range(unlist(RR_df[,1:2]))) +
labs(title = "Effect on total Productivity: trade-offs", x="Resistance", y="Recovery")
