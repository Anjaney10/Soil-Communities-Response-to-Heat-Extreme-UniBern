####################################
# Define points for Trade-Ups plot:
x <- c(1, 2)
# Line 1 points
y1 <- c(2.8, 1)
# Line 2 points
y2 <- c(3, 2.5)
# Create empty plot with custom x-axis labels
plot(x, y1, type = "n", xaxt = "n", ylim = c(0, 4), yaxt = "n",
xlab = "Temperature", ylab = "Growth rate", main="Trade-ups (hotter is better): predict + decoupling")
# Add custom x-axis labels
axis(1, at = c(1, 2), labels = c("Ambient", "Extreme"))
# Draw the two lines
lines(x, y1, col="deepskyblue", lwd = 2)
lines(x, y2, col="coral", lwd = 2)
####################################
# Define points for Trade-Offs plot:
x <- c(1, 2)
# Line 1 points
y1 <- c(2.5, 2)
# Line 2 points
y2 <- c(3.5, 1)
# Create empty plot with custom x-axis labels
plot(x, y1, type = "n", xaxt = "n", ylim = c(0, 4), yaxt = "n",
xlab = "Temperature", ylab = "Growth rate", main="Trade-offs: predict - decoupling")
# Add custom x-axis labels
axis(1, at = c(1, 2), labels = c("Ambient", "Extreme"))
# Draw the two lines
lines(x, y1, col="deepskyblue", lwd = 2)
lines(x, y2, col="coral", lwd = 2)
rm(x, y1, y2)
