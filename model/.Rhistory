sim_1temp(time = times[2]:times[3], # from end of heat pulse to end of time
init = unlist(sim[(times[2]+1),-1]),
params = c(K=K, mu_ambient["mu1"], mu_ambient["mu2"])) # growth rates at ambient
)
return(sim)
}
