plot_muSchematic(mu1_ambient = 1.5, mu1_extreme = 1, mu2_ambient = 2.5, mu2_extreme = 0,
plot_title = "Trade-offs: predict - decoupling")
plot_muSchematic <- function(mu1_ambient, mu1_extreme, mu2_ambient, mu2_extreme,
plot_title){
plot(x=1:2, y=c(mu1_ambient, mu1_extreme),
type = "n", xaxt = "n", ylim = c(-1, 2), yaxt = "n",
xlab = "Temperature", ylab = "Growth rate", main=plot_title)
# Add custom x-axis labels
axis(1, at = c(1, 2), labels = c("Ambient", "Extreme"))
# Draw the two lines
lines(x=1:2, y=c(mu1_ambient, mu1_extreme), col="deepskyblue", lwd = 2)
lines(x=1:2, y=c(mu2_ambient, mu2_extreme), col="coral", lwd = 2)
}
# make plot for no effect:
plot_muSchematic(mu1_ambient = 0.5, mu1_extreme = -0.5, mu2_ambient = 1.5, mu2_extreme = 0.5,
plot_title = "Null hypothesis: predict coupling of resistance & recovery")
# make plot for Trade-Ups:
plot_muSchematic(mu1_ambient = 1.3, mu1_extreme = -0.5, mu2_ambient = 1.5, mu2_extreme = 1,
plot_title = "Trade-ups (hotter is better): predict + decoupling")
# make plot for Trade-Offs:
plot_muSchematic(mu1_ambient = 0.5, mu1_extreme = 0, mu2_ambient = 1.5, mu2_extreme = -1,
plot_title = "Trade-offs: predict - decoupling")
