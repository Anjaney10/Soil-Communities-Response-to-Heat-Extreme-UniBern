# let's try out an example
State <- c(N1=0.001, N2=0.001)
# let's plot the example
simex <- sim_pulse(times=c(5,18,24), init=State, K=10^6,
mu_ambient=c(mu1=0.76, mu2=0.97), mu_extreme=c(mu1=0.7, mu2=0.6)) %>%
pivot_longer(cols = N1:N2)
ggplot(simex, aes(x=time, y=value, colour=name)) +
geom_line() +
scale_y_log10()
