# select the relevant columns from the raw CFU data
CFUraw <- CFUraw_survival %>%
select(Sample, Replicate, Dilution_Counted, Temp, CFU_at_28,
CFU_at_stress, Inoculum, Species, Strain)
# lengthen the data to get Temp at 28, 35, and 40
CFUraw <- CFUraw %>%
pivot_longer(
cols = starts_with("CFU_at"),
names_to = "Condition",
values_to = "CFU"
) %>%
mutate(
Temp = case_when(
Condition == "CFU_at_28" ~ "28",
TRUE ~ as.character(Temp)
),
Temp = factor(Temp, levels = c("28", levels(CFUraw$Temp)))
) %>%
select(-Condition)
# remember that we need to standardize the CFU counts by the dilution to get cell density
CFUraw$CFUdensity <- CFUraw$CFU / CFUraw$Dilution_Counted
#CFUraw$CFUdensity <- CFUraw$CFU
# keep just the P. putida data and summarize it into mean, lwrCI, uprCI
CFUsummary <- CFUraw %>% filter(Species == "P. putida") %>%
group_by(Sample, Temp, Inoculum, Species, Strain) %>%
summarise(meanCFU = mean(CFUdensity),
CFU_lwrCI = quantile(CFUdensity, probs = 0.025),
CFU_uprCI = quantile(CFUdensity, probs = 0.975))
# plot whether the confidence interval of BSC010 is overlapping with the other samples
ggplot(CFUsummary %>%
filter(Inoculum == "Exponential"),
aes(x = Sample, y = meanCFU,
color = Sample)) +
facet_wrap(vars(Temp)) +
# add horizontal dashed lines for BSC010 CIs
geom_hline(data = CFUsummary %>%
filter(Inoculum == "Exponential",
Sample == "BSC010"),
aes(yintercept = CFU_lwrCI),
linetype = "dashed", color = "deepskyblue") +
geom_hline(data = CFUsummary %>%
filter(Inoculum == "Exponential",
Sample == "BSC010"),
aes(yintercept = CFU_uprCI),
linetype = "dashed", color = "deepskyblue") +
# add data points and their confidence intervals on top
geom_point(alpha = 0.25, na.rm = TRUE) +
geom_linerange(aes(ymin = CFU_lwrCI, ymax = CFU_uprCI),
alpha = 0.5, na.rm = TRUE, linetype = "solid") +
scale_color_manual(values = c("BSC010" = "blue4",
"BSC002" = "red",
"BSC015" = "red"),
guide = "none") +
labs(y = "CFU",
title = "Exponential phase inoculum") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
legend.position = "none")
