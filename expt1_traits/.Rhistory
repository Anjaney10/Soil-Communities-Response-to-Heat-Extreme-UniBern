# check numerically to make sure that the confidence intervals are indeed overlapping
CFU_survival.df %>%
filter(Sample %in% c("BSC010", "BSC002", "BSC015")) %>%
group_by(Temp, Inoculum) %>%
reframe(
test_condition = {
lwr010 <- lwr_ci[Sample == "BSC010"]
upr010 <- upr_ci[Sample == "BSC010"]
lwr002 <- lwr_ci[Sample == "BSC002"]
upr002 <- upr_ci[Sample == "BSC002"]
lwr015 <- lwr_ci[Sample == "BSC015"]
upr015 <- upr_ci[Sample == "BSC015"]
(lwr010 <= upr002 & lwr002 <= upr010) &
(lwr010 <= upr015 | lwr015 <= upr010)
}
)
